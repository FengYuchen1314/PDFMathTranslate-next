FROM nginx:1.30.4-alpine@sha256:97d490c12ba55b4946b01546d1c3ed324e8d41ab1c9fcb2a616aa470620e5b46

RUN apk add --no-cache ca-certificates curl gettext openssl

COPY deploy/nginx.portable.conf.template /etc/nginx/templates/pdf2zh.conf.template
COPY deploy/gateway-entrypoint.sh /usr/local/bin/pdf2zh-gateway-entrypoint
COPY deploy/gateway-health.sh /usr/local/bin/pdf2zh-gateway-health
COPY deploy/nginx-portable-reload-loop.sh /usr/local/bin/pdf2zh-nginx-reload-loop

RUN chmod 0755 \
    /usr/local/bin/pdf2zh-gateway-entrypoint \
    /usr/local/bin/pdf2zh-gateway-health \
    /usr/local/bin/pdf2zh-nginx-reload-loop

ENTRYPOINT ["/usr/local/bin/pdf2zh-gateway-entrypoint"]
CMD []

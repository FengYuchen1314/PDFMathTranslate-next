# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca
WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY deploy/requirements.worker.txt deploy/requirements.worker.lock.txt ./deploy/
RUN uv pip install --system --no-cache --compile-bytecode \
        -r deploy/requirements.worker.lock.txt

COPY pdf2zh_next ./pdf2zh_next
RUN uv pip install --system --no-cache --no-deps . \
    && groupadd --gid 10001 app \
    && useradd --create-home --uid 10001 --gid 10001 app \
    && mkdir -p /data/jobs /home/app/.cache /home/app/.config/pdf2zh \
    && chown -R app:app /data /home/app

ENV HOME=/home/app \
    PYTHONUNBUFFERED=1 \
    PDF2ZH_DATA_ROOT=/data/jobs

USER app
RUN babeldoc --version && babeldoc --warmup

USER root
EXPOSE 8000
# Compose adds Tini with `init: true`; clear any inherited entrypoint so its
# sole application child is this one-shot supervisor. The supervisor spawns
# Uvicorn exactly once and then exits with it, forcing a Docker-level restart.
ENTRYPOINT []
CMD ["python", "/app/pdf2zh_next/worker_supervisor.py"]
